[Unit]
Description=DSH token-injecting reverse proxy
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=@DSH_PROXY_USER@
Group=@DSH_PROXY_GROUP@
WorkingDirectory=@DSH_PROXY_HOME@
Environment=HOME=@DSH_PROXY_HOME@
Environment=DSH_HOME=@DSH_PROXY_HOME@/.dsh
Environment=PATH=@DSH_PROXY_PATH@
ExecStart=/usr/local/bin/dsh-proxy --config /etc/dsh-proxy/dsh-proxy.conf
Restart=always
RestartSec=3
TimeoutStopSec=45
KillMode=control-group
LimitNOFILE=65536

# The proxy supervises dsh, and DSH needs the real home directory, its own
# subprocess sandbox, and network access. Avoid ProtectHome/ProtectSystem and
# similar hardening here unless you have verified DSH still works.

[Install]
WantedBy=multi-user.target
