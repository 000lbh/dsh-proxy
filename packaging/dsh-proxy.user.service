[Unit]
Description=DSH token-injecting reverse proxy (user)
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h
Environment=HOME=%h
Environment=DSH_HOME=%h/.dsh
# Adjust PATH so it contains the directory holding dsh.
Environment=PATH=%h/.npm/_npx/1e7f6d9597241db0/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=%h/.local/bin/dsh-proxy --config %h/.config/dsh-proxy/dsh-proxy.conf
Restart=always
RestartSec=3
TimeoutStopSec=45
KillMode=control-group
LimitNOFILE=65536

# systemd --user unit: everything, including dsh, runs as the invoking user.
# For boot without login: sudo loginctl enable-linger <user>

[Install]
WantedBy=default.target
