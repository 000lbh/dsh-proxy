[Unit]
Description=DSH token-injecting reverse proxy (user)
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=@DSH_PROXY_HOME@
Environment=HOME=@DSH_PROXY_HOME@
Environment=DSH_HOME=@DSH_PROXY_HOME@/.dsh
Environment=PATH=@DSH_PROXY_PATH@
ExecStart=@DSH_PROXY_HOME@/.local/bin/dsh-proxy --config @DSH_PROXY_CONFIG@
Restart=always
RestartSec=3
TimeoutStopSec=45
KillMode=control-group
LimitNOFILE=65536

# This is a systemd --user unit: everything, including the dsh child, runs as
# the invoking user. Do not add User=/Group= here, and do not run dsh-proxy
# with sudo. For boot without a login session, enable linger:
#   sudo loginctl enable-linger <user>

[Install]
WantedBy=default.target
